<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="#FFF0F6"
    android:padding="28dp">

    <ImageView
        android:layout_width="96dp"
        android:layout_height="96dp"
        android:src="@drawable/ic_launcher"
        android:layout_marginBottom="18dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="鱼团团"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="#E60067"
        android:layout_marginBottom="10dp" />

    <TextView
        android:id="@+id/statusText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textSize="14sp"
        android:textColor="#7A3B57"
        android:lineSpacingExtra="4dp"
        android:layout_marginBottom="26dp" />

    <Button
        android:id="@+id/permBtn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="① 授予悬浮窗权限"
        android:textColor="#FFFFFF"
        android:backgroundTint="#FF4D94"
        android:layout_marginBottom="12dp" />

    <Button
        android:id="@+id/startBtn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="② 召唤鱼团团"
        android:textColor="#FFFFFF"
        android:backgroundTint="#E60067" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="授权后它就会趴在你屏幕角落，点两下能召唤回来。"
        android:textSize="12sp"
        android:textColor="#B57A93"
        android:layout_marginTop="22dp" />

</LinearLayout>